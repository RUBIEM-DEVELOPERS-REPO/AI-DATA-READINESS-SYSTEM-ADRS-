# ─────────────────────────────────────────────────────────────────────────────
# Data Readiness Hub — Vercel Production Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy these into: Vercel Dashboard → Your Project → Settings → Environment Variables
# Set all to "Production" scope. Use "Preview" scope too for staging previews.
#
# SERVICE PROVISIONING GUIDE:
#   1. Neon     → https://neon.tech        (Serverless Postgres — 3 databases)
#   2. R2       → https://cloudflare.com   (Object storage — zero egress fees)
#   3. Upstash  → https://upstash.com      (Serverless Redis — event bus + cache)
#   4. Ably     → https://ably.com         (Managed WebSocket infrastructure)
# ─────────────────────────────────────────────────────────────────────────────

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=production
# Tells the app it is running inside a Vercel serverless function.
# Disables port binding and native WebSocket server.
VERCEL=1

# ── PostgreSQL Databases (Neon — Serverless Postgres) ────────────────────────
# Create 3 separate Neon projects (or 3 databases in one project).
# ⚠ Always append ?sslmode=require to Neon connection strings.
#
# Main application database (stores users, datasets, extractions, jobs, etc.)
DATABASE_URL=postgresql://<user>:<pass>@<ep-xxx>.us-east-2.aws.neon.tech/<dbname>?sslmode=require

# DPO (Data Protection Officer) portal — isolated database
DPO_DATABASE_URL=postgresql://<user>:<pass>@<ep-yyy>.us-east-2.aws.neon.tech/<dbname>?sslmode=require

# Regulator portal — isolated database
REGULATOR_DATABASE_URL=postgresql://<user>:<pass>@<ep-zzz>.us-east-2.aws.neon.tech/<dbname>?sslmode=require

# Session store — can point at the same Neon DB as DATABASE_URL
SESSION_DATABASE_URL=postgresql://<user>:<pass>@<ep-xxx>.us-east-2.aws.neon.tech/<dbname>?sslmode=require

# ── Authentication ────────────────────────────────────────────────────────────
# Generate a strong secret: openssl rand -hex 64
SESSION_SECRET=<generate-with-openssl-rand-hex-64>

# The default tenant ID used during initial bootstrap seeding
DEFAULT_TENANT=TENANT-001

# Comma-separated list of allowed CORS origins.
# ⚠ Must use https:// in production. No wildcards allowed.
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── Bootstrap Admin (first-run only) ────────────────────────────────────────
# These are used ONCE to create the initial super-admin account.
# Remove or leave blank after the account is created.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=<strong-password-change-immediately>

# ── Object Storage — Cloudflare R2 ───────────────────────────────────────────
# R2 is S3-compatible with zero egress fees. Create a bucket and an API token
# at: Cloudflare Dashboard → R2 → Manage R2 API Tokens
OBJECT_STORE_BACKEND=s3
OBJECT_STORE_S3_BUCKET=data-readiness-hub
OBJECT_STORE_S3_REGION=auto
# Format: https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORE_S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORE_S3_ACCESS_KEY_ID=<r2-access-key-id>
OBJECT_STORE_S3_SECRET_ACCESS_KEY=<r2-secret-access-key>
OBJECT_STORE_S3_PATH_STYLE=false

# ── Event Bus — Upstash Redis ─────────────────────────────────────────────────
# Use the "rediss://" (TLS) URL from Upstash Dashboard → Redis → Details
EVENT_BUS_BACKEND=redis
REDIS_URL=rediss://:<upstash-token>@<region>.upstash.io:6379

# ── Job Queue ─────────────────────────────────────────────────────────────────
# Use the PostgreSQL-backed persistent queue (survives serverless cold starts)
JOB_QUEUE_BACKEND=pg

# ── Real-time Push — Ably ────────────────────────────────────────────────────
# Root API key from: Ably Dashboard → Apps → Your App → API Keys
# ⚠ Never expose this key to the browser — it is server-side only.
# Browser clients receive short-lived tokens from /api/ably/token
ABLY_API_KEY=<app-key>.<secret>

# ── AI Provider ───────────────────────────────────────────────────────────────
# Groq is recommended for fast, low-latency inference on Vercel's 60s limit.
# Switch to OpenAI by setting AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1
AI_PROVIDER=groq
AI_INTEGRATIONS_OPENAI_API_KEY=<groq-or-openai-api-key>
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_TEXT_MODEL=llama-3.3-70b-versatile
AI_VISION_MODEL=llama-3.2-90b-vision-preview
AI_AUDIO_MODEL=whisper-large-v3-turbo

# ── Security ──────────────────────────────────────────────────────────────────
# Disable Replit-specific integrations (always false on Vercel)
ENABLE_REPLIT_INTEGRATIONS=false

# ─────────────────────────────────────────────────────────────────────────────
# GITHUB SECRETS (add to your repo at Settings → Secrets → Actions)
# ─────────────────────────────────────────────────────────────────────────────
# VERCEL_TOKEN        → Vercel Dashboard → Account Settings → Tokens → Create
# VERCEL_ORG_ID       → Found in .vercel/project.json after `vercel link`
# VERCEL_PROJECT_ID   → Found in .vercel/project.json after `vercel link`
#
# Existing secrets (already in repo):
# STAGING_KUBECONFIG    → base64-encoded kubeconfig for K8s staging cluster
# PRODUCTION_KUBECONFIG → base64-encoded kubeconfig for K8s production cluster
# ─────────────────────────────────────────────────────────────────────────────

# ─────────────────────────────────────────────────────────────────────────────
# POST-DEPLOY DATABASE MIGRATION (run once per database after first deploy)
# ─────────────────────────────────────────────────────────────────────────────
# DATABASE_URL="<neon-main-url>" npx drizzle-kit push
# DATABASE_URL="<neon-dpo-url>"  npx drizzle-kit push
# DATABASE_URL="<neon-reg-url>"  npx drizzle-kit push
# ─────────────────────────────────────────────────────────────────────────────
