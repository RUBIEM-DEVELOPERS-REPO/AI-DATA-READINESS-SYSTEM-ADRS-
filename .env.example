# AI Data Readiness System (ADRS) Environment Variables
# ─────────────────────────────────────────────────────────────────────────────

# PostgreSQL Database Connections
# (Required) Main application database connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5444/storage_db
# (Required) Isolation databases for regulator and data protection officer portals
DPO_DATABASE_URL=postgresql://postgres:postgres@localhost:5445/dpo_db
REGULATOR_DATABASE_URL=postgresql://postgres:postgres@localhost:5446/regulator_db
# (Optional) Dedicated PostgreSQL session store URL. Falls back to DATABASE_URL if unset.
SESSION_DATABASE_URL=postgresql://postgres:postgres@localhost:5444/storage_db

# Session Secret (Required)
# Must be set to a strong, unique value in production. Weak values are rejected.
SESSION_SECRET=dev-secret-change-me

# Server Configuration
PORT=5000
HOST=127.0.0.1
# NODE_ENV should be set to "production" in production environments
NODE_ENV=development

# Allowed Origins (CORS CORS Policy)
# Required in production. Comma-separated list of origins. Wildcards are forbidden in prod.
# ALLOWED_ORIGINS=https://app.example.com,https://portal.example.com

# AI Integration Settings
AI_PROVIDER=groq
AI_INTEGRATIONS_OPENAI_API_KEY=sk-placeholder
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.groq.com/openai/v1
AI_TEXT_MODEL=gpt-4.1-mini
AI_VISION_MODEL=gpt-4o
AI_AUDIO_MODEL=gpt-4o-mini-transcribe

# Object Storage Configuration
# Backend option: "local" (default) or "s3"
OBJECT_STORE_BACKEND=local
# S3 Credentials (only required if OBJECT_STORE_BACKEND=s3)
# OBJECT_STORE_S3_BUCKET=my-bucket-name
# OBJECT_STORE_S3_REGION=us-east-1
# OBJECT_STORE_S3_ENDPOINT=https://s3.us-east-1.amazonaws.com
# OBJECT_STORE_S3_ACCESS_KEY_ID=my-s3-access-key-id
# OBJECT_STORE_S3_SECRET_ACCESS_KEY=my-s3-secret-access-key
# OBJECT_STORE_S3_PATH_STYLE=false

# Legacy & Integration Switches
# Set to "true" to enable Replit integrations (disabled by default in prod)
ENABLE_REPLIT_INTEGRATIONS=false
